# Google OAuth 2.0 Credentials
# Get these from Google Cloud Console: https://console.cloud.google.com/
# Ensure Gmail API and Google Calendar API are enabled
# Format: random string from Google
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Notion Integration (Optional)
# Get from: https://www.notion.so/my-integrations
# Format: secret_...
NOTION_API_KEY=your_notion_api_key
NOTION_DATABASE_ID=your_database_id

# Google Calendar Integration (Optional)
GOOGLE_CALENDAR_API_KEY=your_calendar_api_key

# Security
# Run `openssl rand -hex 32` to generate a random 32-byte key
# Example: a1b2c3d4e5f60718293a4b5c6d7e8f901234567890abcdef1234567890abcdef
ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here

# Application Config
SYNC_INTERVAL_MINUTES=5
SYNC_MAX_EMAILS=50
RETRY_ATTEMPTS=6
RETRY_DELAYS=[1, 5, 15, 30, 60, 180]

# Database Configuration
# Default is SQLite for local-first deployment
DATABASE_URL=sqlite:///./data/app.db

# Server Config
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
